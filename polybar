[colors]
background = #1A1A1A
foreground = #FFFFFF
primary = #FFFFFF
active-bg = #636060

[bar/example]
monitor = eDP-1

width = 100%
height = 18

background = ${colors.background}
foreground = ${colors.foreground}

font-0 = MesloLGS NF;2

modules-left = rofi xworkspaces
modules-center = date
modules-right = tray ram separator4 cpu separator3 volume separator bluetooth wifi separator2 power

cursor-click = pointer

[module/rofi]
type = custom/text

format = <label>
label = 
label-foreground = ${colors.foreground}
label-padding = 1

click-left = rofi -show drun

[module/xworkspaces]
type = internal/xworkspaces

label-active = %name%
label-active-background = ${colors.active-bg}
label-active-foreground = ${colors.foreground}
label-active-padding = 1

label-occupied = %name%
label-occupied-foreground = ${colors.foreground}
label-occupied-padding = 1

label-empty =
label-empty-padding = 0

[module/date]
type = internal/date
interval = 1

date = %H:%M
date-alt = %Y.%m.%d %H:%M

label = %date%
label-foreground = ${colors.foreground}

[module/wifi]
type = custom/text

format = <label>
label = 󰖩
label-foreground = ${colors.foreground}
label-padding = 1

click-left = control -w

[module/volume]
type = internal/pulseaudio

format-volume = <label-volume>
label-volume = 󰖀 %percentage%%
label-volume-foreground = ${colors.foreground}
label-volume-padding = 1

format-muted = <label-muted>
label-muted = 󰕿
label-muted-foreground = #888888
label-muted-padding = 1

interval = 5

# Правый клик переключает звук (mute / unmute)
click-right = pactl set-sink-mute @DEFAULT_SINK@ toggle

[module/bluetooth]
type = custom/text

format = <label>
label = 
label-foreground = ${colors.foreground}
label-padding = 1

click-left = control -b

[module/power]
type = custom/text

format = <label>
label = ⏻
label-foreground = ${colors.foreground}
label-padding = 1

click-left = xfce4-session-logout

[module/tray]
type = internal/tray

tray-spacing = 5px
tray-size = 60%
tray-padding = 2

[module/cpu]
type = internal/cpu
interval = 2

format = <label>
label = 󰆓 %percentage%%
label-foreground = ${colors.foreground}
label-padding = 1

[module/ram]
type = internal/memory
interval = 2

format = <label>
label = 󰿗 %percentage_used%%
label-foreground = ${colors.foreground}
label-padding = 1

[module/separator]
type = custom/text

label = ❘
label-foreground = ${colors.foreground}
label-padding = 1

[module/separator2]
type = custom/text

label = ❘
label-foreground = ${colors.foreground}
label-padding = 1

[module/separator3]
type = custom/text

label = ❘
label-foreground = ${colors.foreground}
label-padding = 1

[module/separator4]
type = custom/text

label = ❘
label-foreground = ${colors.foreground}
label-padding = 1

[settings]
screenchange-reload = true
pseudo-transparency = true
