

    "custom/menu": {
        "format": "󰍜",
        "tooltip": false,
        "on-click": "wofi --show drun || rofi -show drun"
    },

    // =====================================================
    // WORKSPACES
    // =====================================================

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    // =====================================================
    // CLOCK + WEATHER
    // =====================================================

    "custom/clockweather": {
    "exec": "~/.config/waybar/scripts/clockweather.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/clockweather.sh toggle && pkill -RTMIN+8 waybar",
    "signal": 8,
    "tooltip": false
    },

    // =====================================================
    // VOLUME
    // =====================================================

    "group/volume": {
        "orientation": "horizontal",

        "drawer": {
            "transition-duration": 300,
            "children-class": "volume-drawer",
            "transition-left-to-right": true
        },

        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",

        "format-muted": "󰝟",

        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },

        "on-click": "pavucontrol",

        "tooltip": false
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    // =====================================================
    // NETWORK / WIFI
    // =====================================================

    "network": {
        "interval": 2,

        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤮",

        "tooltip": true,

        "tooltip-format-wifi": "Wi-Fi\nSSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",

        "tooltip-format-ethernet": "Ethernet\nInterface: {ifname}\nIP: {ipaddr}",

        "tooltip-format-disconnected": "Internet disconnected",

        "on-click": "kitty -- nmtui"
    },

    // =====================================================
    // BLUETOOTH
    // =====================================================

    "bluetooth": {
        "format": "",

        "format-disabled": "󰂲",
        "format-off": "󰂲",

        "tooltip": true,
        "tooltip-format": "Bluetooth",

        "on-click": "blueman-manager"
    },

    // =====================================================
    // RAM
    // =====================================================

    "memory": {
        "interval": 2,

        "format": "󰍛 {percentage}%",

        "tooltip": true,

        "tooltip-format": "{used:0.1f}/{total:0.1f} GB ({percentage}%)"
    },

    // =====================================================
    // DISK
    // =====================================================

    "disk": {
        "interval": 30,

        "path": "/",

        "format": "󰋊 {percentage_used}%",

        "tooltip": true,

        "tooltip-format": "{used}/{total} ({percentage_used}%)"
    },

    // =====================================================
    // BATTERY
    // =====================================================

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{icon} {capacity}%",

        "format-charging": "󰂄 {capacity}%",

        "format-plugged": "󰚥 {capacity}%",

        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip": true,

        "tooltip-format": "{capacity}%"
    },

    // =====================================================
    // POWER
    // =====================================================

    "custom/power": {
        "format": "",

        "tooltip": false,

        "on-click": "wlogout"
    }
}
