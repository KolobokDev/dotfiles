{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 6,

    "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "custom/connectivity",
    "custom/bluetooth"
],

    "modules-center": [
        "custom/clockweather"
    ],

    "modules-right": [
    "group/volume",
    "memory",
    "disk",
    "battery",
    "custom/power"
],

    "custom/menu": {
        "format": "󰍜",
        "tooltip": false,
        "on-click": "wofi --show drun || rofi -show drun"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "custom/clockweather": {
        "exec": "~/.config/waybar/scripts/clockweather.sh",
        "interval": 1,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/clockweather.sh toggle && pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": true,
        "tooltip-format": "Клик — дата и погода"
    },

    "group/volume": {
        "orientation": "horizontal",

        "drawer": {
            "transition-duration": 300,
            "children-class": "volume-drawer",
            "transition-left-to-right": true
        },

        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",

        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },

        "on-click": "pavucontrol",
        "tooltip": false
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "custom/connectivity": {
        "format": "󰖩",
        "tooltip": false,
        "on-click": "control -w"
    },

    "custom/bluetooth": {
        "format": "󰂯",
        "tooltip": false,
        "on-click": "control -b"
    },

    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip": true,
        "tooltip-format": "{used:0.1f}/{total:0.1f} GB ({percentage}%)"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊 {percentage_used}%",
        "tooltip": true,
        "tooltip-format": "{used}/{total} ({percentage_used}%)"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",

        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip": true,
        "tooltip-format": "{capacity}%",
        "on-click": "control -B"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout -b 5"
    }
}