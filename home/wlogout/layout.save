{
    "label": "lock",
    "action": "hyprlock",
    "text": "󰌾",
    "keybind": "l"
},
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "󰒲",
    "keybind": "s"
},
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "󰐥",
    "keybind": "p"
},
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "󰜉",
    "keybind": "r"
},
{
    "label": "logout",
    "action": "hyprctl dispatch exit",
    "text": "󰍃",
    "keybind": "e"
}
