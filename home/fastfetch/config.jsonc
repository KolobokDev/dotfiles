{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " \u001b[37m│ \u001b[0m"
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[37m┌────────────────────────────────────────┐"
    },
    {
      "type": "title",
      "key": "\u001b[37m│ \u001b[31m user   ",
      "format": "{user-name}"
    },
    {
      "type": "host",
      "key": "\u001b[37m│ \u001b[35m󰌢 hname  "
    },
    {
      "type": "uptime",
      "key": "\u001b[37m│ \u001b[34m󰅐 uptime "
    },
    {
      "type": "os",
      "key": "\u001b[37m│ \u001b[33m󰣇 distro "
    },
    {
      "type": "kernel",
      "key": "\u001b[37m│ \u001b[32m kernel "
    },
    {
      "type": "wm",
      "key": "\u001b[37m│ \u001b[36m󰍹 desktop"
    },
    {
      "type": "packages",
      "key": "\u001b[37m│ \u001b[34m󰏖 package"
    },
    {
      "type": "cpu",
      "key": "\u001b[37m│ \u001b[35m cpu    "
    },
    {
      "type": "disk",
      "key": "\u001b[37m│ \u001b[33m󰋊 disk   "
    },
    {
      "type": "memory",
      "key": "\u001b[37m│ \u001b[32m󰍛 memory "
    },
    {
      "type": "custom",
      "format": "\u001b[37m├────────────────────────────────────────┤"
    },
    {
      "type": "colors",
      "key": "\u001b[37m│ \u001b[33m🎨 colors",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└────────────────────────────────────────┘"
    }
  ]
}