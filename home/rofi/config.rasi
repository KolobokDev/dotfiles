* {
    font: "Figtree 13";
    g-spacing: 10px;
    g-margin: 0;

    b-color: #000000FF;
    fg-color: #FFFFFFFF;
    fgp-color: #AAAAAAFF;

    b-radius: 12px;
    g-padding: 8px;

    hl-color: #E5E5E5FF;
    hlt-color: #151515FF;

    /* Единый цвет фона для всех плашек приложений */
    bg-item: #2D2D2DFF;
    alt-color: #2D2D2DFF;

    /* Тёмный фон самого окна */
    wbg-color: #1A1A1AFF; 
    w-border: 1px solid;
    w-border-color: #FFFFFF20;
    w-padding: 12px;
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "❯";

    disable-history: false;
    sort: true;
    sorting-method: "fzf";
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
    spacing: 6px;
}

window {
    width: 450px;

    border-radius: @b-radius;
    background-color: @wbg-color;

    border: @w-border;
    border-color: @w-border-color;
    padding: @w-padding;
}

prompt {
    text-color: @fg-color;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "Search Apps";
    text-color: @fg-color;
    placeholder-color: @fgp-color;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    border-color: @b-color;
    text-color: @fg-color;
}

element-icon {
    size: 28px;
}

element normal.normal {
    background-color: @bg-item;
    text-color: @fg-color;
}

element alternate.normal {
    background-color: @bg-item;
    text-color: @fg-color;
}

element selected.active {
    background-color: @hl-color;
    text-color: @hlt-color;
}

element selected.normal {
    background-color: @hl-color;
    text-color: @hlt-color;
}

message {
    background-color: transparent;
    border: 0px solid;
}